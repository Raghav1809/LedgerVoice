SECRET_KEY=django-insecure-voicekhata-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# ─── Database ──────────────────────────────────────────────────────────────────
# Phase 1: SQLite (local, no PostgreSQL needed)
# No DB vars required — Django uses db.sqlite3 automatically.
#
# Phase 2 (FUTURE): PostgreSQL — set these vars when ready:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ledgervoice_db
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_HOST=localhost
# DB_PORT=5432

# Gemini API Key for AI-powered voice parsing
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
