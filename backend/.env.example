SECRET_KEY=django-insecure-voicekhata-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# ─── Database ──────────────────────────────────────────────────────────────────
# Option A: Local SQLite (Default, runs out of the box)
# DB_ENGINE=django.db.backends.sqlite3

# Option B: PostgreSQL Configuration
# To connect to PostgreSQL, uncomment and customize the following settings:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ledgervoice_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Or use full connection URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgervoice_db

# Gemini API Key for AI-powered voice parsing (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
