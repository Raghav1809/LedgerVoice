SECRET_KEY=django-insecure-voicekhata-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# ─── Database Configuration ───────────────────────────────────────────────────
# Option A: Local PostgreSQL (Default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=voicekhata_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Option B: Live / Cloud PostgreSQL (Neon, Supabase, Render, Railway, AWS RDS, etc.)
# Uncomment and paste your live connection URL:
# DATABASE_URL=postgresql://user:password@ep-host.region.pooler.neon.tech/neondb?sslmode=require
# Or configure individual cloud credentials with SSL:
# DB_NAME=your_cloud_db
# DB_USER=your_cloud_user
# DB_PASSWORD=your_cloud_password
# DB_HOST=your_cloud_host.region.provider.com
# DB_PORT=5432
# DB_SSLMODE=require

# ─── Voice Parsing ────────────────────────────────────────────────────────────
# Optional Gemini AI API Key fallback (pure spaCy NLP rules run locally without key)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS Configuration ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
